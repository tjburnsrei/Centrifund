# Copy to .env.local. Never use the calculator's Neon connection here.
APP_ENV=development
APP_ORIGIN=http://localhost:5180
SUPABASE_URL=
# Server-only current Supabase secret key. Legacy SERVICE_ROLE_KEY is also accepted.
SUPABASE_SECRET_KEY=
# Server-only shared caller password; set privately.
CALLER_PASSWORD=
# Generate a random 32-byte value.
SESSION_SECRET=
# Optional future web administration; no email/SMTP setup needed for the first release.
ADMIN_AUTH_ENABLED=false
# ADMIN_EMAILS=
# SUPABASE_PUBLISHABLE_KEY=
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
CRON_SECRET=
