# Copy to .env.local. Never use the calculator's Neon connection here.
APP_ENV=development
APP_ORIGIN=http://localhost:5180
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Server-only shared caller password; set privately.
CALLER_PASSWORD=
# Generate a random 32-byte value.
SESSION_SECRET=
# Comma-separated, confirmed Supabase Auth users permitted to administer this app.
ADMIN_EMAILS=
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
CRON_SECRET=
